{
  "AppOptions": {
    "FrontendUrl": "http://localhost:3000"
  },
  "WriteDb": {
    "ConnectionString": "Host=localhost;Port=5432;Database=blog-platform-write;Username=postgres;Password=postgres"
  },
  "MongoDB": {
    "ConnectionString": "mongodb://localhost:27017",
    "Database": "blog-platform"
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "PostTtlSeconds": 300
  },
  "RateLimit": {
    "CommentMaxPerWindow": 10,
    "CommentWindowSeconds": 3600
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [{ "Name": "Console" }],
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*"
}